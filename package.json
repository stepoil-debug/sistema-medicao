{
  "name": "sistema-medicao",
  "version": "0.2.0",
  "private": true,
  "description": "Sistema independente de medição com integração ao RDO, Timesheet e regras comerciais versionadas.",
  "scripts": {
    "db:inspect": "node scripts/inspect-databases.mjs",
    "db:inspect:sources": "node scripts/inspect-offshore-source.mjs",
    "db:migrate": "node scripts/apply-migration.mjs",
    "db:sync": "node scripts/run-draft-check.mjs",
    "measurement:sync": "node scripts/run-draft-check.mjs",
    "measurement:check": "node scripts/run-draft-check.mjs",
    "measurement:verify": "node scripts/verify-engine.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "UNLICENSED",
  "type": "module",
